rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Approved creatives: the apps and the pages read them, only the admin writes.
    match /creatives/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == '5bCbdUU29cPtffTXwNJw5DzigSd2';
    }

    // Files from the public form wait here until the `submit` function checks them and moves them
    // into submissions/. Anyone may add a file, nobody reads or changes it; `cleanupUploads`
    // deletes what is left after a day. Images up to 1 MB, GIFs up to 2 MB, MP4 up to 6 MB.
    match /uploads/{rand}/{file} {
      allow create: if (request.resource.contentType.matches('image/(webp|png|jpeg)')
                        && request.resource.size <= 1024 * 1024)
                    || (request.resource.contentType == 'image/gif'
                        && request.resource.size <= 2 * 1024 * 1024)
                    || (request.resource.contentType == 'video/mp4'
                        && request.resource.size <= 6 * 1024 * 1024);
    }

    // Checked files of the requests: only the admin (and the functions) read, change or delete.
    match /submissions/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == '5bCbdUU29cPtffTXwNJw5DzigSd2';
    }
  }
}
